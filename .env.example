# ─── Local development environment variables ──────────────────────────────────
# Copy this file to .env and fill in the real values.
# .env is git-ignored – NEVER commit real secrets.

# Azure Blob Storage connection string
# Get from: Azure Portal → Storage accounts → <account> → Security + networking → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<ACCOUNT_NAME>;AccountKey=<ACCOUNT_KEY>;EndpointSuffix=core.windows.net

# Azure Blob Storage container name
AZURE_STORAGE_CONTAINER_NAME=qakiosblob

# Server port (optional, defaults to 8085)
# SERVER_PORT=8085
